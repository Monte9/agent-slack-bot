# Bot User OAuth Token from the app's "OAuth & Permissions" page (starts with xoxb-)
SLACK_BOT_TOKEN=

# App-Level Token from "Basic Information" > "App-Level Tokens", scope connections:write (starts with xapp-)
SLACK_APP_TOKEN=

# Optional. Path to config.json (default: ./config.json)
# CONFIG_PATH=

# Optional. Only needed for a runtime that is not backed by your Claude login.
# ANTHROPIC_API_KEY=
